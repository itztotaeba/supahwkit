<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  activity_main.xml - Layout Dashboard (halaman utama) aplikasi.
  ============================================================================
  STRUKTUR:
  <androidx.coordinatorlayout...>  root: mendukung perilaku scroll modern
    ├── AppBarLayout                : "app bar" material yang bisa naik/turun
    │     └── header (judul + sub)  : branding & penjelasan singkat aplikasi
    └── RecyclerView                : grid 2 kolom berisi 8 card kit
          (layoutManager & adapter dipasang dari kode Kotlin di MainActivity)

  CATATAN BELAJAR:
  - xmlns:android  = namespace atribut standar Android.
  - xmlns:app      = namespace atribut library (AppCompat/Material).
  - tools:xxx      = atribut PREVIEW saja (muncul di Android Studio design
                     view, tidak masuk ke APK) -> berguna untuk teks contoh.
  - match_parent   = selebar/tinggi parent; wrap_content = seukuran isinya.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background"
    tools:context=".ui.dashboard.MainActivity">

    <!-- ===== APP BAR: judul dashboard ===== -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_gradient"
        app:elevation="4dp"> <!-- bayangan tipis memisahkan header dari konten -->

        <!-- LinearLayout vertikal menumpuk title di atas subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_title"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/dashboard_subtitle"
                android:textColor="#CCFFFFFF" <!-- putih 80% alpha: hierarki visual -->
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ===== GRID DAFTAR KIT =====
         app:layout_behavior: kunci integrasi dengan AppBarLayout -
         membuat list mulai tepat DI BAWAH app bar & ikut bergeser saat
         app bar collapse saat scrolling. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKitMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"          <!-- padding tak memotong konten saat scroll -->
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:itemCount="8"
        tools:listitem="@layout/item_kit_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
