<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  strings.xml - Seluruh teks UI terpusat di sini (best practice Android).
  ============================================================================
  Alasan tidak hardcode text di layout/kode:
  1. Siap lokalisasi (buat values-en/, values-id/ berisi terjemahan).
  2. Edit teks cukup satu tempat; Compose membacanya via stringResource().
  %1$d / %1$s adalah placeholder format string yang diisi dari kode
  lewat stringResource(R.string.xxx, argumen).
  -->
