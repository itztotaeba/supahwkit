<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  activity_kit_detail.xml - Layout halaman demo per-kit.
  ============================================================================
  Fase sekarang: shell informatif (ikon, nama, deskripsi, status implementasi).
  Nanti area containerDemo akan diisi fragment/view demo tiap kit
  (MapView, tombol scan, hasil OCR, dst).
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true" <!-- jika konten pendek, tetap penuhi layar -->
    android:background="@color/dashboard_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Ikon kit diperbesar sebagai identitas halaman -->
        <ImageView
            android:id="@+id/ivKitDetailIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:padding="16dp"
            android:contentDescription="@null"
            tools:background="@color/kit_map"
            tools:src="@drawable/ic_map" />

        <TextView
            android:id="@+id/tvKitDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Map Kit" />

        <TextView
            android:id="@+id/tvKitDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#666666"
            android:textSize="14sp"
            tools:text="Deskripsi singkat kit" />

        <!-- Kartu status implementasi -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <TextView
                android:id="@+id/tvKitStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:text="Implementasi Map Kit segera hadir." />
        </com.google.android.material.card.MaterialCardView>

        <!-- Container kosong: slot tempat demo kit dipasang secara dinamis -->
        <FrameLayout
            android:id="@+id/containerDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
