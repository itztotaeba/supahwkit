<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  item_kit_menu.xml - Layout SATU card menu kit di dashboard.
  ============================================================================
  Layout ini di-inflate berulang kali oleh KitMenuAdapter.onCreateViewHolder.
  Karena dipakai dalam GridLayoutManager 2 kolom, lebarnya harus 0dp +
  layout_weight agar fleksibel mengikuti lebar sel grid.

  HIERARKI VIEW:
  MaterialCardView (card berbayangan & rounded corner)
    └── LinearLayout horizontal
          ├── FrameLayout  : kotak ikon berwarna (ikon + background aksen)
          └── LinearLayout : kolom teks (title + description)
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardKitMenu"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"   <!-- sudut membulat khas material -->
    app:cardElevation="2dp"       <!-- bayangan halus = kesan "terangkat" -->
    app:rippleColor="@color/purple_200"> <!-- efek riak saat diketuk -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical" <!-- ikon & teks sejajar tengah -->
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Kotak ikon: FrameLayout menumpuk ImageView di atas warna latar -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/ivKitIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null" <!-- dekoratif, bukan utk screen reader -->
                android:padding="10dp"             <!-- kecilkan glyph dlm kotaknya -->
                android:scaleType="fitCenter"
                app:tint="@color/white"            <!-- ikon vektor diwarnai putih -->
                tools:background="@color/kit_map"
                tools:src="@drawable/ic_map" />
        </FrameLayout>

        <!-- Kolom teks: weight 1 = sisakan ruang penuh setelah ikon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvKitTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"    <!-- jika terlalu panjang -> titik-titik -->
                android:maxLines="1"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Map Kit" />

            <TextView
                android:id="@+id/tvKitDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#666666"
                android:textSize="11sp"
                tools:text="Tampilkan peta interaktif" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
