<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  themes.xml - Jembatan tema XML -> Compose.
  ============================================================================
  Meski UI sudah full Jetpack Compose, Android MASIH membutuhkan satu theme
  XML saat Activity dibuat (sebelum setContent pertama kali merender).
  Theme NoActionBar dipilih karena:
   - App bar digambar Compose (TopAppBar), bukan ActionBar sistem.
   - windowBackground diberi warna netral agar tidak "flash putih" ketika
     aplikasi dibuka sebelum frame Compose pertama tampil.
  Seluruh palet/warna/font sebenarnya diatur di ui/theme/Theme.kt (Compose).
  ============================================================================
-->
<resources>
    <style name="Theme.SupaHWKit" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/dashboard_background</item>
    </style>
</resources>
